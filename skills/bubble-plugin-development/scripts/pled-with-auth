#!/usr/bin/env bash
# Installed as ~/.local/bin/pled; the original executable lives in libexec.
set +x
set -euo pipefail

pled_binary="$HOME/.local/libexec/pled"
if [[ ! -x "$pled_binary" ]]; then
  printf 'Pled executable missing: %s\n' "$pled_binary" >&2
  exit 1
fi

# Local commands do not need credentials.
case "${1:-help}" in
  help|-h|--help|--version|encode) exec "$pled_binary" "$@" ;;
esac

if [[ -n "${BUBBLE_COOKIE:-}" && "$BUBBLE_COOKIE" != op://* ]]; then
  exec "$pled_binary" "$@"
fi

cookie_ref="${BUBBLE_COOKIE:-}"
if [[ -z "$cookie_ref" && -r "$HOME/.config/pled/cookie-reference" ]]; then
  cookie_ref="$(< "$HOME/.config/pled/cookie-reference")"
fi
if [[ "$cookie_ref" != op://* ]]; then
  printf 'Configure a 1Password reference in ~/.config/pled/cookie-reference.\n' >&2
  exit 1
fi

# Prefer the current saved token over credentials inherited by long-lived shells.
if [[ -r "$HOME/.config/op/service-account-token" ]]; then
  export OP_SERVICE_ACCOUNT_TOKEN="$(< "$HOME/.config/op/service-account-token")"
fi
if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
  printf 'Pled needs ~/.config/op/service-account-token or OP_SERVICE_ACCOUNT_TOKEN.\n' >&2
  exit 1
fi

# op run stops on lookup failure and injects the cookie only into this process.
export BUBBLE_COOKIE="$cookie_ref"
exec op run -- "$pled_binary" "$@"
